# Copy this file to .env.local and fill it in. .env.local is never committed.

# Firebase console → Project settings → Your apps → Qorelly Store Web → SDK setup and configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Cloud console → Security → Fraud Defense (reCAPTCHA) → your key → ID
VITE_RECAPTCHA_SITE_KEY=

# Firebase console → App Check → Apps → ⋮ → Manage debug tokens → Add → Generate.
# Used by `npm run dev` only. Treat it like a password.
VITE_APPCHECK_DEBUG_TOKEN=
